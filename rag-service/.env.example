# Cấu hình Spring Boot Backend URL (trong docker-compose dùng http://backend:8080/api)
SPRING_BOOT_URL=http://localhost:8080/api

# Cấu hình kết nối trực tiếp database PostgreSQL của Spring Boot để đồng bộ dữ liệu
DATABASE_URL=postgresql://library_user:library_pass@localhost:5432/library_db

# Google Gemini API Key (Lấy tại Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Key dùng để xác thực các yêu cầu nội bộ từ Spring Boot (ví dụ: kích hoạt đồng bộ sách)
INTERNAL_API_KEY=SuperSecretInternalApiKey123!

# Thư mục lưu trữ dữ liệu ChromaDB bền vững
CHROMA_PERSIST_DIR=./chroma_data

# Môi trường chạy (development / production)
ENV=development
