# Spring Boot backend URL. In Docker Compose, use http://backend:8080/api.
SPRING_BOOT_URL=http://localhost:8080/api

# Direct PostgreSQL connection used by the RAG service to sync book data.
DATABASE_URL=postgresql://library_user:library_pass@localhost:5432/library_db

# DeepSeek API for the chatbot LLM.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MAX_TOKENS=1200

# Shared key for internal sync requests from Spring Boot. Must be changed if ENV is production.
INTERNAL_API_KEY=SuperSecretInternalApiKey123!

# Persistent ChromaDB data directory.
CHROMA_PERSIST_DIR=./chroma_data

# Runtime environment: development or production.
ENV=development
